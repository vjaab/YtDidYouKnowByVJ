<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width={{ canvas_width|default(1080) }}, height={{ canvas_height|default(1350) }}">
  <title>{{ hook or headline or 'AI Breakdown' }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --canvas-w: {{ canvas_width|default(1080) }}px;
      --canvas-h: {{ canvas_height|default(1350) }}px;
      --color-byte-primary: {{ theme.accent_primary|default('#00F2FE') }};
      --color-byte-glow: {{ theme.accent_glow|default('rgba(0, 242, 254, 0.35)') }};
      --color-vj-primary: {{ theme.accent_secondary|default('#38BDF8') }};
      --color-vj-glow: {{ theme.accent_glow|default('rgba(56, 189, 248, 0.38)') }};
      --color-asha-primary: {{ theme.accent_secondary|default('#38BDF8') }};
      --color-asha-glow: {{ theme.accent_glow|default('rgba(56, 189, 248, 0.38)') }};
      --color-bg-dark: {{ theme.bg_dark|default('#0B0F19') }};
      --color-card-bg: {{ theme.card_bg|default('rgba(16, 24, 44, 0.90)') }};
      --color-text-main: #FFFFFF;
      --color-text-sub: #94A3B8;
      --color-accent-tag-bg: {{ theme.accent_tag_bg|default('linear-gradient(135deg, #00F2FE 0%, #0077FE 100%)') }};
      --color-accent-tag-color: {{ theme.accent_tag_color|default('#031427') }};
      --color-secondary-tag-bg: {{ theme.secondary_tag_bg|default('linear-gradient(135deg, #38BDF8 0%, #0284C7 100%)') }};
      --color-secondary-tag-color: {{ theme.secondary_tag_color|default('#031427') }};
    }

    body {
      width: var(--canvas-w);
      height: var(--canvas-h);
      overflow: hidden;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--color-bg-dark);
      color: var(--color-text-main);
      -webkit-font-smoothing: antialiased;
    }

    /* Container canvas */
    .dialogue-canvas {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 56px 60px 48px 60px;
      background: {{ theme.bg_gradient|default('radial-gradient(circle at 50% 0%, #172554 0%, #0B0F19 60%, #030712 100%)') }};
      overflow: hidden;
    }

    /* Optional AI or custom background image overlay */
    {% if background_image_url or background_image_path %}
    .bg-overlay-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ background_image_url or background_image_path }}');
      background-size: cover;
      background-position: center;
      opacity: 0.22;
      filter: saturate(1.2) contrast(1.1);
      z-index: 1;
    }
    {% endif %}

    /* Subtle cyber grid and ambient glow orbs */
    .bg-mesh-glow {
      position: absolute;
      top: -120px;
      left: 50%;
      transform: translateX(-50%);
      width: 900px;
      height: 500px;
      background: {{ theme.mesh_glow|default('radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, rgba(168, 85, 247, 0.12) 50%, transparent 75%)') }};
      filter: blur(80px);
      pointer-events: none;
      z-index: 2;
    }

    .bg-grid {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 80%);
      pointer-events: none;
      z-index: 2;
    }

    /* ── Header ─────────────────────────────────────────── */
    .header-bar {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .badge-wrap {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .topic-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 22px;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--color-vj-primary);
      backdrop-filter: blur(12px);
    }

    .topic-badge .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--color-vj-primary);
      box-shadow: 0 0 12px var(--color-vj-glow);
    }

    .topic-badge.badge-dyk {
      background: {{ theme.badge_bg|default('rgba(0, 242, 254, 0.12)') }};
      border: 1.5px solid {{ theme.badge_border|default('rgba(0, 242, 254, 0.4)') }};
      color: var(--color-byte-primary);
      box-shadow: 0 0 25px var(--color-byte-glow);
    }

    .topic-badge.badge-dyk .dot {
      background: var(--color-byte-primary);
      box-shadow: 0 0 14px var(--color-byte-glow);
    }

    .slide-counter {
      padding: 10px 20px;
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 22px;
      font-weight: 700;
      color: #CBD5E1;
      letter-spacing: 1px;
    }

    /* Top Carousel Hook Title */
    .top-hook {
      position: relative;
      z-index: 10;
      margin-top: 24px;
      font-family: 'Outfit', sans-serif;
      font-size: 46px;
      font-weight: 800;
      line-height: 1.18;
      letter-spacing: -0.5px;
      text-align: left;
      background: linear-gradient(135deg, #FFFFFF 20%, #E2E8F0 60%, #94A3B8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    /* ── Main Dialogue Stage ────────────────────────────── */
    .dialogue-stage {
      position: relative;
      z-index: 10;
      flex: 1;
      display: flex;
      align-items: center;
      margin: 20px 0;
    }

    /* Speaker on LEFT (Byte default) */
    .stage-speaker-left {
      flex-direction: row;
      justify-content: flex-start;
    }

    /* Speaker on RIGHT (Asha default) */
    .stage-speaker-right {
      flex-direction: row-reverse;
      justify-content: flex-start;
    }

    /* Character sprite container */
    .character-wrap {
      position: absolute;
      bottom: -30px;
      z-index: 12;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .character-wrap.speaker-byte {
      left: 10px;
    }

    .character-wrap.speaker-asha,
    .character-wrap.speaker-vj {
      right: 10px;
    }

    .character-img {
      max-height: 760px;
      max-width: 500px;
      object-fit: contain;
      pointer-events: none;
      filter: drop-shadow(0 24px 32px rgba(0, 0, 0, 0.5));
    }

    .speaker-byte .character-img {
      filter: drop-shadow(0 20px 36px var(--color-byte-glow)) drop-shadow(0 10px 20px rgba(0,0,0,0.6));
    }

    .speaker-asha .character-img,
    .speaker-vj .character-img {
      filter: drop-shadow(0 20px 36px var(--color-vj-glow)) drop-shadow(0 10px 20px rgba(0,0,0,0.6));
    }

    /* Speaker Name Badge */
    .speaker-tag {
      margin-top: -30px;
      padding: 8px 24px;
      border-radius: 999px;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      z-index: 15;
    }

    .speaker-byte .speaker-tag {
      background: var(--color-accent-tag-bg);
      color: var(--color-accent-tag-color);
      border: 2px solid rgba(255, 255, 255, 0.4);
    }

    .speaker-asha .speaker-tag,
    .speaker-vj .speaker-tag {
      background: var(--color-secondary-tag-bg);
      color: var(--color-secondary-tag-color);
      border: 2px solid rgba(255, 255, 255, 0.4);
    }

    /* ── Speech Bubble ──────────────────────────────────── */
    .speech-bubble-container {
      position: absolute;
      top: 10%;
      z-index: 20;
      width: 560px;
    }

    .stage-speaker-left .speech-bubble-container {
      right: 20px;
    }

    .stage-speaker-right .speech-bubble-container {
      left: 20px;
    }

    .speech-bubble {
      position: relative;
      background: var(--color-card-bg);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border-radius: 36px;
      padding: 44px 44px 40px 44px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }

    .stage-speaker-left .speech-bubble {
      border: 2.5px solid {{ theme.bubble_border_left|default('rgba(0, 242, 254, 0.45)') }};
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 40px var(--color-byte-glow);
    }

    .stage-speaker-right .speech-bubble {
      border: 2.5px solid {{ theme.bubble_border_right|default('rgba(56, 189, 248, 0.45)') }};
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 40px var(--color-vj-glow);
    }

    /* Bubble Emotion Badge */
    .emotion-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .stage-speaker-left .emotion-pill {
      background: {{ theme.badge_bg|default('rgba(0, 242, 254, 0.12)') }};
      color: var(--color-byte-primary);
      border: 1px solid {{ theme.badge_border|default('rgba(0, 242, 254, 0.3)') }};
    }

    .stage-speaker-right .emotion-pill {
      background: {{ theme.badge_bg|default('rgba(56, 189, 248, 0.12)') }};
      color: var(--color-vj-primary);
      border: 1px solid {{ theme.badge_border|default('rgba(56, 189, 248, 0.3)') }};
    }

    /* Stat Highlight Callout (Dynamic Layout Variety) */
    .stat-highlight-box {
      display: inline-flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 20px;
      padding: 10px 24px;
      background: rgba(255, 255, 255, 0.08);
      border: 2px solid var(--color-byte-primary);
      border-radius: 20px;
      box-shadow: 0 0 30px var(--color-byte-glow);
    }

    .stat-highlight-box .stat-value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 52px;
      font-weight: 900;
      color: var(--color-byte-primary);
      letter-spacing: -1px;
      text-shadow: 0 0 20px var(--color-byte-glow);
    }

    .stat-highlight-box .stat-label {
      font-size: 20px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #E2E8F0;
    }

    /* Speech Bubble Text */
    .bubble-text {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 44px;
      font-weight: 700;
      line-height: 1.36;
      color: #FFFFFF;
      letter-spacing: -0.3px;
      word-break: break-word;
    }

    /* Speech Bubble Tails */
    /* Pointing LEFT towards Byte */
    .stage-speaker-left .speech-bubble::before {
      content: "";
      position: absolute;
      left: -26px;
      top: 50%;
      transform: translateY(-50%);
      width: 0;
      height: 0;
      border-top: 18px solid transparent;
      border-bottom: 18px solid transparent;
      border-right: 28px solid {{ theme.bubble_border_left|default('rgba(0, 242, 254, 0.5)') }};
    }

    .stage-speaker-left .speech-bubble::after {
      content: "";
      position: absolute;
      left: -22px;
      top: 50%;
      transform: translateY(-50%);
      width: 0;
      height: 0;
      border-top: 16px solid transparent;
      border-bottom: 16px solid transparent;
      border-right: 24px solid var(--color-card-bg);
    }

    /* Pointing RIGHT towards Asha */
    .stage-speaker-right .speech-bubble::before {
      content: "";
      position: absolute;
      right: -26px;
      top: 50%;
      transform: translateY(-50%);
      width: 0;
      height: 0;
      border-top: 18px solid transparent;
      border-bottom: 18px solid transparent;
      border-left: 28px solid {{ theme.bubble_border_right|default('rgba(56, 189, 248, 0.5)') }};
    }

    .stage-speaker-right .speech-bubble::after {
      content: "";
      position: absolute;
      right: -22px;
      top: 50%;
      transform: translateY(-50%);
      width: 0;
      height: 0;
      border-top: 16px solid transparent;
      border-bottom: 16px solid transparent;
      border-left: 24px solid var(--color-card-bg);
    }

    /* ── Special Takeaway Slide Layout (Last Slide) ────────── */
    .takeaway-stage {
      position: relative;
      z-index: 10;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      gap: 28px;
      padding: 0 20px;
    }

    .takeaway-card {
      width: 100%;
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.95) 0%, rgba(15, 23, 42, 0.95) 100%);
      border: 2px solid {{ theme.takeaway_border|default('rgba(56, 189, 248, 0.4)') }};
      border-radius: 36px;
      padding: 48px 48px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 50px {{ theme.accent_glow|default('rgba(56, 189, 248, 0.15)') }};
      position: relative;
      overflow: hidden;
    }

    .takeaway-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: {{ theme.accent_gradient|default('linear-gradient(90deg, #00F2FE 0%, #A855F7 50%, #FF5E8E 100%)') }};
    }

    .takeaway-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 24px;
      background: {{ theme.badge_bg|default('rgba(56, 189, 248, 0.15)') }};
      border: 1px solid {{ theme.badge_border|default('rgba(56, 189, 248, 0.4)') }};
      border-radius: 999px;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: var(--color-vj-primary);
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    .takeaway-text {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 40px;
      font-weight: 700;
      line-height: 1.38;
      color: #FFFFFF;
      margin-bottom: 20px;
    }

    /* News Citation */
    .source-citation {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 24px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 600;
      color: #94A3B8;
    }

    /* CTA Card */
    .cta-banner {
      width: 100%;
      background: {{ theme.cta_bg|default('linear-gradient(135deg, #0284C7 0%, #2563EB 50%, #7C3AED 100%)') }};
      border-radius: 28px;
      padding: 32px 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .cta-content {
      text-align: left;
    }

    .cta-heading {
      font-family: 'Outfit', sans-serif;
      font-size: 32px;
      font-weight: 800;
      color: #FFFFFF;
      margin-bottom: 4px;
    }

    .cta-sub {
      font-size: 20px;
      font-weight: 600;
      color: #E0F2FE;
    }

    .cta-btn {
      padding: 14px 28px;
      background: #FFFFFF;
      color: #0F172A;
      font-size: 22px;
      font-weight: 800;
      border-radius: 999px;
      letter-spacing: 0.5px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    }

    /* Takeaway Dual Mascots footer row */
    .takeaway-mascots-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      width: 100%;
      margin-top: -10px;
      height: 280px;
    }

    .mini-mascot-left, .mini-mascot-right {
      height: 280px;
      object-fit: contain;
      filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.5));
    }

    /* ── Footer Bar ─────────────────────────────────────── */
    .footer-bar {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .brand-id {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: {{ theme.accent_gradient|default('linear-gradient(135deg, #00F2FE 0%, #7C3AED 100%)') }};
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 18px;
      color: #FFFFFF;
      box-shadow: 0 4px 12px var(--color-byte-glow);
    }

    .brand-handle {
      font-size: 22px;
      font-weight: 700;
      color: #E2E8F0;
      letter-spacing: 0.5px;
    }

    .swipe-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 20px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 999px;
      font-size: 18px;
      font-weight: 800;
      color: #F8FAFC;
      letter-spacing: 1px;
    }

    .swipe-pill .arrow {
      color: var(--color-byte-primary);
      font-weight: 900;
    }
  </style>
</head>
<body>
  <div class="dialogue-canvas">
    
    <!-- Optional Background Overlay Image -->
    {% if background_image_url or background_image_path %}
    <div class="bg-overlay-img"></div>
    {% endif %}

    <!-- Atmospheric Mesh Glow & Tech Grid -->
    <div class="bg-mesh-glow"></div>
    <div class="bg-grid"></div>

    <!-- Header -->
    <header class="header-bar">
      <div class="badge-wrap">
        <div class="topic-badge {{ 'badge-dyk' if mode in ['did_you_know', 'dyk'] else '' }}">
          <span class="dot"></span>
          <span>{{ category or ('🧠 DID YOU KNOW?' if mode in ['did_you_know', 'dyk'] else ('AI NEWS' if mode == 'news' else 'AI EXPLAINED')) }}</span>
        </div>
      </div>
      <div class="slide-counter">
        {{ "%02d"|format(slide_current) }} / {{ "%02d"|format(slide_total) }}
      </div>
    </header>

    <!-- Top Hook / Title -->
    <h1 class="top-hook">{{ slide_title or hook or headline }}</h1>

    {% if is_takeaway %}
    <!-- ── Special Final Slide Layout ─────────────────────── -->
    <div class="takeaway-stage">
      
      <div class="takeaway-card">
        <div class="takeaway-badge">{{ '🤯 Mind-Blowing Fact' if mode in ['did_you_know', 'dyk'] else '💡 Key Takeaway' }}</div>
        <div class="takeaway-text">"{{ takeaway or slide_data.bubble }}"</div>
        
        {% if source %}
        <div class="source-citation">
          <span>📰 Source: {{ source }}{% if date %}, {{ date }}{% endif %}</span>
        </div>
        {% endif %}
      </div>

      <div class="cta-banner">
        <div class="cta-content">
          <div class="cta-heading">{{ 'Follow for Daily Mind-Blowing Tech Facts' if mode in ['did_you_know', 'dyk'] else 'Follow for Daily AI Breakdowns' }}</div>
          <div class="cta-sub">{{ brand.handle|default('@vijayakumarj_ai') }} • {{ 'Save this for later 📌' if platform == 'instagram' else ('Repost with thoughts 🔁' if platform == 'threads' else 'Share with friends 👉') }}</div>
        </div>
        <div class="cta-btn">FOLLOW ➔</div>
      </div>

      <div class="takeaway-mascots-row">
        {% if character_byte_path %}
        <img class="mini-mascot-left" src="{{ character_byte_path }}" alt="Byte Robot">
        {% endif %}
        {% if character_vj_path %}
        <img class="mini-mascot-right" src="{{ character_vj_path }}" alt="VJ">
        {% elif character_asha_path %}
        <img class="mini-mascot-right" src="{{ character_asha_path }}" alt="VJ">
        {% endif %}
      </div>

    </div>

    {% else %}
    <!-- ── Standard Dialogue Slide Layout ─────────────────── -->
    <div class="dialogue-stage {{ 'stage-speaker-left' if speaker == 'byte' else 'stage-speaker-right' }}">
      
      <!-- Character Mascot -->
      <div class="character-wrap speaker-{{ speaker }}">
        {% if character_img_path %}
        <img class="character-img" src="{{ character_img_path }}" alt="{{ speaker }}">
        {% endif %}
        <div class="speaker-tag">
          {% if speaker == 'byte' %}🤖 BYTE{% else %}👨‍💻 VJ{% endif %}
        </div>
      </div>

      <!-- Speech Bubble -->
      <div class="speech-bubble-container">
        <div class="speech-bubble">
          {% if emotion %}
          <div class="emotion-pill">
            {% if emotion == 'curious' %}❓ CURIOUS
            {% elif emotion == 'thinking' %}🤔 THINKING
            {% elif emotion == 'excited' %}⚡ EXCITED
            {% elif emotion == 'shocked' %}🤯 SHOCKED
            {% elif emotion == 'smug' %}😎 CONFIDENT
            {% else %}💬 SPEAKING
            {% endif %}
          </div>
          {% endif %}

          {% if slide_data.highlight_stat %}
          <div class="stat-highlight-box">
            <span class="stat-value">{{ slide_data.highlight_stat }}</span>
            {% if slide_data.stat_label %}
            <span class="stat-label">{{ slide_data.stat_label }}</span>
            {% endif %}
          </div>
          {% endif %}

          <div class="bubble-text">{{ slide_data.bubble }}</div>
        </div>
      </div>

    </div>
    {% endif %}

    <!-- Footer -->
    <footer class="footer-bar">
      <div class="brand-id">
        <div class="brand-avatar">VJ</div>
        <div class="brand-handle">{{ brand.handle|default('@vijayakumarj_ai') }}</div>
      </div>
      <div class="swipe-pill">
        <span>{% if is_takeaway %}FOLLOW{% else %}SWIPE{% endif %}</span>
        <span class="arrow">➔</span>
      </div>
    </footer>

  </div>
</body>
</html>
